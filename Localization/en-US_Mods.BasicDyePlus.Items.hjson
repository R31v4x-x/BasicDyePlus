Unmarked_Dye: {
	DisplayName: Unmarked Dye
	MixedDisplayName: "{0} and {1} Mixed Dye"
	ComboDisplayName: "{0} and {1} Dye"
	Tooltip: A dye with no set features
}

Wecho_Dye: {
	DisplayName: Wecho Dye
	Tooltip:
		'''
		Unaffected by {$ItemName.EchoMonolith} and {$ItemName.SpectreGoggles}
		When used in the {$Dye_Mixing_Vat_Item.DisplayName} it'll have different effects depending on the mode
		{$UI.DyeCombine.Mixing.DisplayName}: Reduce the saturation
		{$UI.DyeCombine.Combo.DisplayName}: Outcome will have no color in the respective slot
		'''
}

Dye_Mixing_Vat_Item: {
	DisplayName: Dye Mixing Vat
	Tooltip: Allows you to combine basic color dyes
}
